# Create a bot in the Discord Developer Portal and keep the token out of Git.
DISCORD_TOKEN=replace-me

# Relative paths are resolved from the project directory.
DEBILGI_DATABASE_PATH=data/debilgi.sqlite3
DEBILGI_MIGRATIONS_PATH=migrations
DEBILGI_LOG_LEVEL=INFO

# Enable briefly when registering or changing slash commands.
DEBILGI_SYNC_COMMANDS=false

# Local test mode: reply with harmless rule-based text only when directly mentioned.
DEBILGI_TEST_REPLIES=false

# Cross-source response arbitration. Active changes the selected reply; shadow only records it.
DEBILGI_ARBITRATION_MODE=active
DEBILGI_ARBITRATION_MIN_SCORE=0.45
DEBILGI_ARBITRATION_MAX_TOTAL_CANDIDATES=48
DEBILGI_ARBITRATION_LEARNING_ENABLED=true
DEBILGI_ARBITRATION_LEARNING_RATE=0.03
DEBILGI_ARBITRATION_MIN_FEEDBACK_OBSERVATIONS=20
DEBILGI_ARBITRATION_MAX_WEIGHT_DELTA=0.05
DEBILGI_INITIATIVE=false
DEBILGI_WIKIPEDIA_ENABLED=false
DEBILGI_WIKIPEDIA_LANGUAGE=ru
DEBILGI_WIKIPEDIA_TIMEOUT_SECONDS=5
DEBILGI_WIKIPEDIA_REPLY_WAIT_MILLISECONDS=1800
DEBILGI_WIKIPEDIA_USER_AGENT=DEBiLGI/0.6 (mailto:local-operator@example.invalid)
DEBILGI_RUSSIAN_REFERENCE_ENABLED=false
DEBILGI_RUSSIAN_REFERENCE_TIMEOUT_SECONDS=5
DEBILGI_RUSSIAN_REFERENCE_USER_AGENT=DEBiLGI/0.6 (mailto:local-operator@example.invalid)
DEBILGI_LANGUAGE_MAX_OUTPUT_TOKENS=72
DEBILGI_LANGUAGE_MAX_OUTPUT_CHARS=1200
DEBILGI_LANGUAGE_CONTEXT_CHARS=600
DEBILGI_DISCOURSE_CONTEXT_TURNS=80
DEBILGI_DISCOURSE_MAX_TURNS=20000

# Word-form learning, explicit uncertainty and coherent conversation sessions.
DEBILGI_CHARACTER_MARKOV_MIN_ORDER=2
DEBILGI_CHARACTER_MARKOV_MAX_ORDER=8
DEBILGI_CHARACTER_MARKOV_MAX_WORD_LENGTH=32
DEBILGI_CHARACTER_MARKOV_GENERATION_ATTEMPTS=24
DEBILGI_CONVERSATION_IDLE_TIMEOUT_MINUTES=45
DEBILGI_CONVERSATION_MAX_IDLE_TIMEOUT_MINUTES=60
DEBILGI_NEOLOGISM_MIN_RESPONSE_INTERVAL=75
DEBILGI_NEOLOGISM_MAX_PER_MESSAGE=1
DEBILGI_NEOLOGISM_EXPIRATION_DAYS=30
DEBILGI_CURIOSITY_QUESTION_COOLDOWN_MINUTES=30
DEBILGI_CURIOSITY_MAX_CONSECUTIVE_QUESTIONS=1
DEBILGI_CURIOSITY_THRESHOLD=0.68
DEBILGI_UNKNOWN_WORD_THRESHOLD=0.45
DEBILGI_RESPONSE_CONFIDENCE_THRESHOLD=0.45
DEBILGI_RESPONSE_PLAN_RETRY_LIMIT=2

# Optional structural teacher. Live replies never wait for it or copy its wording.
# Start integrations/puter-sidecar, open /bridge and keep that browser tab running.
DEBILGI_SEMANTIC_CONSULTANT_ENABLED=false
DEBILGI_SEMANTIC_CONSULTANT_ENDPOINT=http://127.0.0.1:43127/v1/consult
DEBILGI_SEMANTIC_CONSULTANT_MODEL=google/gemini-3.5-flash
DEBILGI_SEMANTIC_CONSULTANT_TIMEOUT_SECONDS=45
DEBILGI_SEMANTIC_CONSULTANT_TRIGGER_THRESHOLD=0.72
DEBILGI_SEMANTIC_CONSULTANT_MINIMUM_CONFIDENCE=0.58
# Use the same value as PUTER_SIDECAR_SECRET in the Node sidecar process.
DEBILGI_SEMANTIC_CONSULTANT_SECRET=
DEBILGI_OPEN_QUESTION_TTL_MESSAGES=2
DEBILGI_CONTEXT_GATE_WINDOW_TURNS=5
DEBILGI_CONTEXT_GATE_MINIMUM_MATCHES=1
DEBILGI_CONTEXT_GATE_INITIATIVE_IDLE_SECONDS=300

# Independent scheduled learning and graph maintenance (not message-triggered).
DEBILGI_BACKGROUND_ENABLED=false
DEBILGI_BACKGROUND_INTERVAL_SECONDS=600
DEBILGI_BACKGROUND_WORDS_PER_CYCLE=5
DEBILGI_BACKGROUND_MAX_STUDY_ATTEMPTS=4
DEBILGI_BACKGROUND_GRAPH_DECAY_DAILY_RATE=0.015
DEBILGI_BACKGROUND_SELF_CHECK_CYCLES=6
DEBILGI_BACKGROUND_INITIATIVE_ENABLED=false
DEBILGI_BACKGROUND_INITIATIVE_PROBABILITY=0.25
DEBILGI_BACKGROUND_INITIATIVE_COOLDOWN_MINUTES=60

# Optional: sync commands instantly to one development server.
# DEBILGI_DEV_GUILD_ID=123456789012345678

# Short-term memory limits and decay.
DEBILGI_MEMORY_RETENTION_MINUTES=60
DEBILGI_MEMORY_CHARGE_HALF_LIFE_MINUTES=15
DEBILGI_MEMORY_MAX_TOTAL_EVENTS=5000
DEBILGI_MEMORY_MAX_CHANNEL_EVENTS=100
DEBILGI_MEMORY_MAX_USER_EVENTS=50
DEBILGI_MEMORY_MAX_REPLY_CHAINS=100
DEBILGI_MEMORY_MAX_CHAIN_EVENTS=50
DEBILGI_MEMORY_MAX_CONTEXT_EVENTS=24
DEBILGI_MEMORY_RELEVANCE_HALF_LIFE_MINUTES=20
DEBILGI_MEMORY_MIN_CONTEXT_RELEVANCE=0.10
DEBILGI_MEMORY_CONSOLIDATION_MIN_IMPORTANCE=0.34
DEBILGI_MEMORY_CONSOLIDATION_BATCH_SIZE=12
DEBILGI_MEMORY_LONG_TERM_CAPSULE_LIMIT=5000
DEBILGI_MEMORY_LONG_TERM_RECALL_LIMIT=6

# Shadow prediction and Cognitive Core maintenance. Nothing here executes Discord actions.
DEBILGI_EXPECTATION_HORIZON_SECONDS=120
DEBILGI_EXPECTATION_POLL_SECONDS=5
DEBILGI_COGNITIVE_EPISODE_GAP_SECONDS=600
DEBILGI_COGNITIVE_MAINTENANCE_SECONDS=60
DEBILGI_COGNITIVE_BATCH_SIZE=100
DEBILGI_RAW_TEXT_RETENTION_DAYS=30
