# Private overrides copied to .env.local by bootstrap.py or debilgi-init.
# Tokens are normally entered through `debilgi-secrets setup` and stored in
# .debilgi-secrets.vault instead of this plaintext file.

# Any setting from .env.example may be overridden here.
# DEBILGI_PRODUCTIVE_ONLY_REPLIES=true
# DEBILGI_VAULT_EXTRA_KEYS=MY_OTHER_API_TOKEN

# Plaintext credentials remain supported only as an explicit compatibility mode:
# DISCORD_TOKEN=
